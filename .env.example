# NODE_ENV: Set to 'production' on Hostinger
NODE_ENV="production"

# PORT: Optional port override (Hostinger automatically provides this or defaults to 3000)
PORT="3000"

# GEMINI_API_KEY: Optional for server-side Gemini AI features (auto-injected in AI Studio)
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL=""

# ===================================================================
# MAXPACK UAE - GOOGLE SHEETS DATABASE CONFIGURATION
# ===================================================================
# 1. Create a Google Cloud Project & enable the Google Sheets API.
# 2. Create a Service Account (e.g. maxpack-erp@your-project.iam.gserviceaccount.com) and download its JSON Key.
# 3. Create a Google Spreadsheet (e.g., 'Maxpack ERP Database') and SHARE editor access with the Service Account email.
# 4. Fill in the values below:

GOOGLE_SHEETS_SPREADSHEET_ID="1BxiMVs0XRX..."
GOOGLE_SERVICE_ACCOUNT_EMAIL="maxpack-erp@project-id.iam.gserviceaccount.com"
# Note: In private key, replace newlines with \n or supply raw single line
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"

# STORAGE_MODE: "memory" (built-in persistent state with seeded Maxpack data) or "google_sheets"
STORAGE_MODE="memory"

# Business Settings
MAXPACK_COMPANY_NAME="Maxpack Packaging LLC"
MAXPACK_TRN="100234857600003"
MAXPACK_CURRENCY="AED"
MAXPACK_VAT_RATE="0.05"
